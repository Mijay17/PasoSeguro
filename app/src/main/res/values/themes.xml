<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PasoSeguro" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Tema de arranque: muestra ic_launcher.png mientras carga la app y
         luego cambia automáticamente a Theme.PasoSeguro (postSplashScreenTheme). -->
    <style name="Theme.PasoSeguro.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PasoSeguro</item>
    </style>
</resources>
