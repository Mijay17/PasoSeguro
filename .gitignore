# ─────────────────────────────────────────────────────────────────────────────
# .gitignore para proyecto Android — Jetpack Compose / Kotlin
# ─────────────────────────────────────────────────────────────────────────────

# ── Gradle cache del proyecto (binarios de lock, checksums, etc.) ─────────────
.gradle/

# ── Carpetas de build generadas automáticamente ───────────────────────────────
# Nunca deben versionarse: se recrean con cada compilación.
# **/build/ cubre además cualquier módulo futuro además de :app (hoy el único).
/build/
app/build/
**/build/

# ── Native build (NDK / CMake) — no se usa hoy, pero se recrea automáticamente
.cxx/
.externalNativeBuild/

# ── Capturas de Layout Inspector / Profiler y volcados de memoria ─────────────
captures/
*.hprof

# ── Configuración local de la máquina y credenciales ──────────────────────────
# local.properties contiene sdk.dir (ruta ABSOLUTA del SDK) y MAPS_API_KEY.
# Si se sube, rompe el clone de otros desarrolladores y filtra la API key.
local.properties
secrets.properties
key.properties
keystore.properties

# ── Sesiones del daemon de Kotlin ─────────────────────────────────────────────
.kotlin/

# ── Android Studio — archivos personales o de caché de la IDE ─────────────────
# Estos archivos son específicos de cada desarrollador / instalación.
# Los archivos de configuración compartible (.name, gradle.xml, misc.xml,
# vcs.xml, compiler.xml, runConfigurations.xml, inspectionProfiles/)
# SÍ se mantienen versionados porque ayudan a onboardear nuevos colaboradores.
.idea/workspace.xml
.idea/caches/
.idea/deploymentTargetSelector.xml
.idea/migrations.xml
.idea/markdown.xml
.idea/deviceManager.xml

# Módulos .iml — regenerados por Android Studio, específicos del checkout local.
*.iml

# ── Artefactos compilados ─────────────────────────────────────────────────────
*.apk
*.aab
*.ap_
*.dex

# ── Keystores de firma (CRÍTICO: nunca versionar claves de firma) ─────────────
*.jks
*.keystore

# ── Archivos generados por sistemas operativos ────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db

# ── Carpeta docs/ (imágenes y referencias de diseño) ──────────────────────────
docs/
